#!/usr/bin/env python3
"""Use the existing Steam compositor in game mode, avoiding a nested one."""
import os,sys
args=sys.argv[1:]
if os.environ.get('WANGAN_USE_EXISTING_GAMESCOPE')=='1':
    cmd=args[args.index('--')+1:]
    os.execvp(cmd[0],cmd)
os.execv('/usr/bin/gamescope',['gamescope',*args])
